# ============================================
# DATABASE
# ============================================

DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ============================================
# JWT AUTHENTICATION
# ============================================

JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"

# ============================================
# SERVER
# ============================================

NODE_ENV="development"
PORT="3001"

# ============================================
# REDIS (for rate limiting)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=template:

# ============================================
# RESEND EMAIL CONFIGURATION
# ============================================

# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ✅ FOR DEVELOPMENT - Use Resend's test domain (no verification needed)
EMAIL_FROM=onboarding@resend.dev

# ❌ FOR PRODUCTION - Replace with your verified domain
# EMAIL_FROM=noreply@yourdomain.com

EMAIL_FROM_NAME=Dancan Kalerwa Portfolio
FRONTEND_URL=http://localhost:3000

# ✅ FOR TESTING - Use delivered@resend.dev to test without real email
# EMAIL_RECIPIENT=delivered@resend.dev

# ✅ FOR PRODUCTION - Use your real email address
EMAIL_RECIPIENT=your-email@gmail.com

# Dummy values - Required by ConfigModule (not used with Resend)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=dummy@example.com
EMAIL_PASSWORD=dummy-password

# ============================================
# OTHER EMAIL PROVIDERS (Optional)
# ============================================

# Gmail SMTP (alternative to Resend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourapp.com
# EMAIL_FROM_NAME=Your App Name

# Mailtrap (for development testing)
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=your-mailtrap-username
# EMAIL_PASSWORD=your-mailtrap-password
# EMAIL_FROM=noreply@yourapp.com
# EMAIL_FROM_NAME=Your App Name

# ============================================
# TESTING
# ============================================

TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# ============================================
# CORS
# ============================================

CORS_ORIGINS=http://localhost:3000,https://your-frontend.com

# ============================================
# ADMIN ACCOUNT (YOUR REAL CREDENTIALS)
# ============================================

ADMIN_EMAIL=Your email.@gmail.com
ADMIN_PASSWORD=YourRealPasswordHere
ADMIN_NAME=Your name